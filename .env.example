# Alamat dasar API (tanpa garis miring di akhir). Kosong = origin yang sama.
VITE_API_BASE_URL=http://localhost:54321
# development | production. Pada production galat tidak dicetak ke konsol.
VITE_APP_ENV=development
# Subpath penyajian, mis. /app. Bawaan: /
VITE_BASE_PATH=/
# Kunci situs Cloudflare Turnstile (pelaporan foto). Kosong = widget tidak tampil.
VITE_TURNSTILE_SITE_KEY=
# Origin untuk tautan yang dibagikan (mis. https://loque.id). Kosong = origin halaman.
VITE_PUBLIC_BASE_URL=
# Hanya untuk `pnpm dev`: lewati login dengan sesi palsu (customer, customer-new, owner, admin_kasir,
# super_admin, barber, guest). Bisa juga lewat ?devrole=<peran> di URL. Diabaikan pada build produksi.
# VITE_DEV_ROLE=customer
